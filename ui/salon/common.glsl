// Kontrol Merkezi · the hall's live renderer: what every pass shares (docs/SALON.md, "The pack", "The live renderer").
// Deterministic: no random numbers, no frame counter; the same inputs give the same pixels.
precision highp float;
precision highp int;
precision highp sampler2D;
precision highp sampler3D;
precision highp sampler2DArray;

const float PI = 3.14159265358979;
const float Y0 = 0.282095, Y1 = 0.488603;
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

uniform vec3 uGroup[3];        // live colour of each light group, C_g k_g (linear)
uniform float uPhaseG;         // the medium's Henyey-Greenstein g (first order)

vec3 safe3(vec3 c) { return (any(isnan(c)) || any(isinf(c))) ? vec3(0.0) : clamp(c, vec3(0.0), vec3(60000.0)); }
float lum(vec3 c) { return dot(c, LUMA); }

// ---- the volumes of baked light in the air (SALON.md: M mean radiance, a = open air; F luminance flux; per group).
// The shaders read them combined with the groups' live colours: salon.js renders, whenever a colour changes, each
// volume into one 3D texture of four blocks side by side along x:
//   Mc = sum_g C_g k_g M_g (rgb), air       K_c = sum_g C_g[c] k_g (M_g[c] / lum M_g) F_g   for c = r, g, b
// so the in-scatter towards r is Mc + 3 g (K_r.r, K_g.r, K_b.r) and the irradiance for n is pi Mc + 2 pi (K_c . n),
// exactly the per-group sums of SALON.md in four reads instead of six. Reads are clamped half a cell inside each block
// (filtering never mixes blocks). Index 0 is the finest volume, NV - 1 the outer one (the whole hall). The samplers
// and volRead() are generated by salon.js (an array of samplers can only be indexed by constants).
uniform vec4 uVolLo[NV];       // xyz: lower corner (m), w: cell (m)
uniform vec4 uVolN[NV];        // xyz: cells per axis
// VOLUMES

struct Air { vec3 M, Kr, Kg, Kb; float open; };

// The light in the air at p: the finest volume that holds p, blended into the next one across its last cell (no seam
// where a fine volume ends). first: the first volume to consider (NV - 1: the outer one only).
Air lightAt(vec3 p, int first) {
    Air a = Air(vec3(0.0), vec3(0.0), vec3(0.0), vec3(0.0), 0.0);
    float rem = 1.0;
    for (int i = 0; i < NV; i++) {
        if (i < first || ((VOL_MASK >> i) & 1) == 0) continue;   // VOL_MASK: the volumes this program declares
        vec3 n = uVolN[i].xyz;
        vec3 q = (p - uVolLo[i].xyz) / uVolLo[i].w;
        vec3 e = min(q, n - q);
        float edge = min(e.x, min(e.y, e.z));
        if (edge <= 0.0 && i < NV - 1) continue;
        float w = (i == NV - 1) ? rem : rem * clamp(edge, 0.0, 1.0);
        vec3 c = clamp(q, vec3(0.5), n - 0.5) / n;
        c.x *= 0.25;
        vec4 m, kr, kg, kb;
        volRead(i, c, m, kr, kg, kb);
        a.M += w * m.rgb;
        a.open += w * m.a;
        a.Kr += w * kr.xyz;
        a.Kg += w * kg.xyz;
        a.Kb += w * kb.xyz;
        rem -= w;
        if (rem <= 0.001) break;
    }
    return a;
}

// ---- shading pieces shared by the light map surfaces and the live ones (rotors, levers)
float ggxD(float ndh, float a) {
    float a2 = a * a, d = ndh * ndh * (a2 - 1.0) + 1.0;
    return a2 / (PI * d * d);
}
float smithVis(float ndv, float ndl, float a) {          // height-correlated Smith, divided by 4 ndv ndl
    float a2 = a * a;
    float gv = ndl * sqrt(ndv * ndv * (1.0 - a2) + a2), gl = ndv * sqrt(ndl * ndl * (1.0 - a2) + a2);
    return 0.5 / max(gv + gl, 1e-5);
}
vec3 envBRDF(vec3 f0, float rough, float ndv) {          // Karis' analytic fit of the split-sum's second term
    const vec4 c0 = vec4(-1.0, -0.0275, -0.572, 0.022), c1 = vec4(1.0, 0.0425, 1.04, -0.04);
    vec4 r = rough * c0 + c1;
    float a004 = min(r.x * r.x, exp2(-9.28 * ndv)) * r.x + r.y;
    vec2 ab = vec2(-1.04, 1.04) * a004 + r.zw;
    return f0 * ab.x + ab.y;
}

// One light group's contribution to a surface, from its dominant direction (dir, share w of directional light, I its
// irradiance at normal incidence), its irradiance E for the normal and the radiance of its non-directional rest.
struct Surf { vec3 n, v, albedo, f0; float rough, metal, ao, so; };
vec3 shadeGroup(Surf s, vec3 E, vec3 dir, float w, vec3 I, vec3 Lamb) {
    float ndv = max(dot(s.n, s.v), 1e-4);
    vec3 diffuse = s.albedo * (1.0 - s.metal) * E * (s.ao / PI);
    // the directional part as a light from dir, the lobe widened by how spread the light is (1 - w)
    float a = clamp(s.rough * s.rough + (1.0 - w) * 0.35, 0.002, 1.0);
    vec3 h = normalize(s.v + dir);
    float ndl = max(dot(s.n, dir), 0.0), ndh = max(dot(s.n, h), 0.0), vdh = max(dot(s.v, h), 0.0);
    vec3 F = s.f0 + (1.0 - s.f0) * pow(1.0 - vdh, 5.0);
    vec3 spec = I * F * (ggxD(ndh, a) * smithVis(ndv, ndl, a) * ndl);
    // the rest as uniform light: the split-sum's environment term
    spec += Lamb * envBRDF(s.f0, s.rough, ndv);
    return diffuse + spec * s.so;
}

// a surface lit from the volumes (rotors, levers): E(n) = pi M + 2 pi (F . n) M / lum(M), summed over the groups;
// the dominant direction and its share from the combined luminance flux
vec3 shadeFromVolumes(Surf s, vec3 p) {
    Air a = lightAt(p, 0);
    vec3 E = max(PI * a.M + 2.0 * PI * vec3(dot(a.Kr, s.n), dot(a.Kg, s.n), dot(a.Kb, s.n)), 0.1 * PI * a.M);
    vec3 F = a.Kr * LUMA.r + a.Kg * LUMA.g + a.Kb * LUMA.b;
    float lm = max(lum(a.M), 1e-8), fl = length(F);
    vec3 dir = fl > 1e-9 ? F / fl : s.n;
    float w = clamp(fl / lm, 0.0, 1.0);
    return shadeGroup(s, E, dir, w, 4.0 * PI * a.M * w, a.M * (1.0 - w));
}

// ---- the camera: rays for full-screen passes
uniform vec3 uEye, uCamF, uCamR, uCamU;
uniform vec2 uTan;             // tan(fov/2) * aspect, tan(fov/2)
uniform vec2 uNearFar;
vec3 viewRay(vec2 uv) { return normalize(uCamF + (2.0 * uv.x - 1.0) * uTan.x * uCamR + (2.0 * uv.y - 1.0) * uTan.y * uCamU); }
float viewZ(float d) { float n = uNearFar.x, f = uNearFar.y; return 2.0 * n * f / (f + n - (2.0 * d - 1.0) * (f - n)); }
