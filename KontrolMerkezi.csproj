<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>KontrolMerkezi</AssemblyName>
    <RootNamespace>KontrolMerkezi</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>kontrol.ico</ApplicationIcon>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Product>Kontrol Merkezi</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The NvAPI write to the GPU's light controller (src/Rgb/MsiGpuV2.cs) is in the normal build since 11-16. A build
       with -p:GpuIsik=kapali has no path to the card at all (the card commands then only simulate). -->
  <PropertyGroup>
    <GpuIsik Condition="'$(GpuIsik)' == ''">acik</GpuIsik>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GpuIsik)' == 'acik'">
    <DefineConstants>$(DefineConstants);GPU_ISIK</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Management" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="LibreHardwareMonitorLib">
      <HintPath>lib\LibreHardwareMonitorLib.dll</HintPath>
    </Reference>
    <Reference Include="HidSharp">
      <HintPath>lib\HidSharp.dll</HintPath>
    </Reference>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ui\**\*.*" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The hall's data pack (docs/SALON.md), built by sahne\firin (salon.exe bake) into sahne\paket: copied next to the
       exe as sahne\ so the installer carries it. Not embedded (hundreds of MB). -->
  <ItemGroup>
    <SahnePaketi Include="sahne\paket\**\*.*" />
  </ItemGroup>
  <Target Name="SahnePaketiniKopyala" AfterTargets="Build" Condition="Exists('sahne\paket\sahne.json')">
    <RemoveDir Directories="$(OutDir)sahne" />
    <Copy SourceFiles="@(SahnePaketi)" DestinationFiles="@(SahnePaketi->'$(OutDir)sahne\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
  </Target>

  <ItemGroup>
    <None Include="lib\*.dll" Exclude="lib\LibreHardwareMonitorLib.dll;lib\HidSharp.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
